# Application
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# Authentik OIDC (Provider application)
AUTHENTIK_ISSUER=https://auth.example.com/application/o/neuland-connect/
AUTHENTIK_CLIENT_ID=your-authentik-client-id
AUTHENTIK_CLIENT_SECRET=your-authentik-client-secret

# Authentik API (service account token with user write permissions)
AUTHENTIK_API_URL=https://auth.example.com
AUTHENTIK_API_TOKEN=your-authentik-api-token

# Optional: Neuland Next Mitgliedsausweis (defaults to app slug `next`)
# AUTHENTIK_NEXT_APP_SLUG=next
# AUTHENTIK_NEXT_OAUTH_PROVIDER_ID=15

# GitHub OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub App (org invitations — optional until org sync is enabled)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=neuland-ingolstadt

# Internal cron endpoints
# POST /api/internal/github-org/sync
# POST /api/internal/github-teams/sync
# POST /api/internal/discord-roles/sync
CRON_SECRET=

# Discord OAuth App (account linking)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Discord bot (guild join + role sync)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id

# Discord slash command /connect (Interactions URL + signature verification)
# Public key: Discord Developer Portal → Application → General Information
DISCORD_PUBLIC_KEY=your-discord-public-key

# Gateway presence (bot shows online). Set false on extra replicas if you scale horizontally.
DISCORD_BOT_GATEWAY=true

# Campus Life Events (Neuland public + internal calendar)
CL_API_KEY=
# CL_API_URL=https://cl.neuland-ingolstadt.de/api
