{
  "name": "neuland-connect",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "lint": "biome check",
    "fmt": "biome check --fix",
    "fmt:unsafe": "biome check --fix --unsafe",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build --build-arg BUN_VERSION=$(tr -d '[:space:]' < .bun-version) -t neuland-connect ."
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "2.5.9",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.32",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
