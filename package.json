{
  "name": "neuland-connect",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "lint": "biome check",
    "fmt": "biome check --fix",
    "fmt:unsafe": "biome check --fix --unsafe",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build --build-arg BUN_VERSION=$(tr -d '[:space:]' < .bun-version) -t neuland-connect ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.61",
    "cborg": "6.1.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "croner": "10.0.1",
    "jsqr": "1.4.0",
    "lucide-react": "1.60.0",
    "nitro": "3.0.260610-beta",
    "pako": "3.0.2",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@biomejs/biome": "2.5.15",
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.41",
    "@types/node": "26.6.5",
    "@types/pako": "3.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
